  {
   "group": "Solver",
   "items": [
    {
     "path": "simulation.max_step_ns",
     "label": "Maximum time step",
     "unit": "ns",
     "type": "float",
     "tip": "5 ns resolves the mux switching edges; coarser steps give noisy baselines."
    }
   ]
  }
 ],
 "tables": [
  {
   "path": "forces",
   "title": "Input profile: force pulses",
   "tip": "One row per trapezoidal force pulse on a sensor (channel 0..14). Rows on the same address add up. About 0.12 N already reaches VREF for a 0.7 mm sensor.",
   "columns": [
    {
     "key": "address",
     "label": "Channel",
     "type": "int",
     "min": 0,
     "max": 14
    },
    {
     "key": "t_start_us",
     "label": "Start [us]",
     "type": "float"
    },
    {
     "key": "rise_us",
     "label": "Rise [us]",
     "type": "float"
    },
    {
     "key": "width_us",
     "label": "Hold [us]",
     "type": "float"
    },
    {
     "key": "fall_us",
     "label": "Fall [us]",
     "type": "float"
    },
    {
     "key": "amp_N",
     "label": "Amplitude [N]",
     "type": "float"
    }
   ],
   "new_row": {
    "address": 2,
    "t_start_us": 20.0,
    "rise_us": 40.0,
    "width_us": 150.0,
    "fall_us": 40.0,
    "amp_N": 0.05
   }
  },
  {
   "path": "forces_sin",
   "title": "Input profile: sine waves",
   "add_label": "Add sin",
   "tip": "One row per sinusoidal force on a sensor: F = amplitude x sin(2 pi f t) for the given number of cycles starting at Start (zero before and after, so it swings both ways around the VMID level). Rows on the same address add up and also add to the pulses above.",
   "columns": [
    {
     "key": "address",
     "label": "Channel",
     "type": "int",
     "min": 0,
     "max": 14
    },
    {
     "key": "t_start_us",
     "label": "Start [us]",
     "type": "float"
    },
    {
     "key": "freq_hz",
     "label": "Frequency [Hz]",
     "type": "float",
     "min": 0
    },
    {
     "key": "cycles",
     "label": "Cycles",
     "type": "float",
     "min": 0
    },
    {
     "key": "amp_N",
     "label": "Amplitude [N]",
     "type": "float"
    }
   ],
   "new_row": {
    "address": 2,
    "t_start_us": 20.0,
    "freq_hz": 20000.0,
    "cycles": 3,
    "amp_N": 0.05
   }
  }
