    {
     "path": "sensor_defaults.r_insulation_ohm",
     "label": "Insulation resistance",
     "unit": "ohm",
     "type": "float",
     "tip": "DC leakage of the element (placeholder 10 Gohm)."
    },
    {
     "path": "sensor_defaults.loss_model",
     "label": "Dielectric loss model",
     "unit": "",
     "type": "choice",
     "tip": "none = ideal Cp. parallel_r = tan delta as a parallel resistor (creates a DC leak).",
