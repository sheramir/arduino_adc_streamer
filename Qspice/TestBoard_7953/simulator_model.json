 "system": [
  {
   "group": "Scan of this ADC",
   "items": [
    {
     "path": "timing.scan_order",
     "label": "Scan order (mux channels)",
     "unit": "",
     "type": "intlist",
     "tip": "Comma separated sensor channels 0..14, each once."
    },
    {
     "path": "timing.repeat",
     "label": "Repeats (conversions per channel)",
     "unit": "",
     "type": "int",
     "tip": "The ADC converts the same channel this many frames in a row before switching to the next channel or VMID; only the last conversion is kept. Each extra repeat adds one frame to the connected time."
    },
    {
     "path": "timing.vmid_between_channels",
     "label": "VMID visit after every channel",
     "unit": "",
     "type": "bool",
     "tip": "Firmware 'VMID between channels': 2 VMID frames after every channel (stream = n*(repeats+2) frames)."
    },
    {
     "path": "timing.vmid_frames_between",
     "label": "VMID frames after a channel",
     "unit": "",
     "type": "int",
     "tip": ""
    },
    {
     "path": "timing.n_adc",
     "label": "Number of ADCs in the sweep",
     "unit": "",
     "type": "int",
     "tip": "This ADC plus the others that are clocked one after another on the shared sequence while this mux is parked on VMID. 1 = this ADC alone. The frames of the other ADCs are derived from the ADC frame timing."
    },
    {
     "path": "timing.other_adc_channels",
     "label": "Channels streamed by each other ADC",
     "unit": "",
     "type": "int",
     "tip": "Default 10 (ADC1/ADC3 route 10 channels). Each other ADC clocks channels x repeats + 2 pipeline frames per sweep, at the same frame period as this ADC."
    },
    {
     "path": "timing.sweep_gap_us",
     "label": "Extra gap per sweep (software, USB)",
     "unit": "us",
     "type": "float",
     "tip": "Parked on VMID. Default 0."
    },
    {
     "path": "timing.t_start_us",
     "label": "Start delay",
     "unit": "us",
     "type": "float",
     "tip": ""
    }
   ]
  },
  {
   "group": "SPI and frame timing",
   "items": [
    {
     "path": "timing.spi_clk_hz",
     "label": "ADC SPI clock",
     "unit": "Hz",
     "type": "float",
     "tip": "20 MHz (type 20meg)."
    },
    {
     "path": "timing.adc_word_clocks",
     "label": "SCLK clocks per frame",
     "unit": "",
     "type": "int",
     "tip": "ADS7953: 16."
    },
    {
     "path": "timing.frame_gap_ns",
     "label": "Gap between frames",
     "unit": "ns",
     "type": "float",
     "tip": "CS-high guard plus software time. 1200 ns gives ~2 us frames (measured 16,889 sweeps/s over 29 frame slots)."
    },
    {
     "path": "timing.first_clock_delay_ns",
     "label": "First SCLK edge after CS falls",
     "unit": "ns",
     "type": "float",
     "tip": "Assumed 25 ns (illustration in the timing report); measure with a scope."
    }
   ]
  }
 ],
 "simulation": [
  {
   "group": "Measurement time",
