    },
    {
     "path": "timing.num_cycles",
     "label": "Sweeps",
     "unit": "",
     "type": "int",
     "tip": "Used when no run duration is set."
    },
    {
     "path": "timing.tail_us",
     "label": "Tail after the last sweep",
     "unit": "us",
