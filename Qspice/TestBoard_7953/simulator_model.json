    {
     "path": "sensor_defaults.eps33_r",
     "label": "Relative permittivity eps33T/eps0",
     "unit": "",
     "type": "float",
     "tip": "Steminc SM311: 3500 at 1 kHz."
    },
    {
     "path": "sensor_defaults.d33_pC_per_N",
     "label": "d33 charge constant",
     "unit": "pC/N",
     "type": "float",
     "tip": "Steminc SM311: 600 pC/N."
    },
    {
     "path": "sensor_defaults.force_gain",
     "label": "Force gain",
     "unit": "",
     "type": "float",
     "tip": ""
